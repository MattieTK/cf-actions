{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-actions",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The backstop: redeliver failed webhooks, re-drive stuck launches, reconcile lost stops.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // Comma-separated GitHub owners (users or orgs) allowed to use these runners. Empty = any
    // owner the GitHub App is installed on (the App is private, so only its owner can install it).
    "ALLOWED_OWNERS": "",
    // Self-hosted runners on public repos let anyone who opens a PR run code on them.
    "ALLOW_PUBLIC_REPOS": "false",
    // Stop a runner that has not picked up a job after this long.
    "IDLE_TIMEOUT_MINUTES": "10",
    // Hard limit on a single container's lifetime (GitHub-hosted runners also cap jobs at 6h).
    "MAX_JOB_MINUTES": "360",
    // Runner group for organisation runners. 1 is the "Default" group.
    "RUNNER_GROUP_ID": "1"
  },

  // One container application per machine size: Cloudflare fixes the instance type per class.
  "containers": [
    {
      "class_name": "Runner1Cpu",
      "image": "./container/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 10,
      // Do not replace a running job's container during a deploy for up to 6 hours.
      "rollout_active_grace_period": 21600
    },
    {
      "class_name": "Runner2Cpu",
      "image": "./container/Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 10,
      "rollout_active_grace_period": 21600
    },
    {
      "class_name": "Runner4Cpu",
      "image": "./container/Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 10,
      "rollout_active_grace_period": 21600
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RUNNER_1CPU", "class_name": "Runner1Cpu" },
      { "name": "RUNNER_2CPU", "class_name": "Runner2Cpu" },
      { "name": "RUNNER_4CPU", "class_name": "Runner4Cpu" },
      { "name": "APP_REGISTRY", "class_name": "AppRegistry" },
      { "name": "JOB_LEDGER", "class_name": "JobLedger" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Runner1Cpu", "Runner2Cpu", "Runner4Cpu", "AppRegistry", "JobLedger"]
    }
  ]
}
